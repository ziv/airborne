{
  "config": {
    "global": {
      "title": "airborne",
      "width": 1200,
      "height": 800,
      "fov": 85,
      "tilt": 0.25,
      "near_plane": 1,
      "far_plane": 100000,
      "resources": "assets/resources.jsonc"
    },
    "window": {
      "title": "airborne",
      "width": 1200,
      "height": 800,
      "near_plane": 1,
      "far_plane": 100000
    },
    "player": {
      "camera": {
        // field of view a little bit wider than the human FOV for wider sight
        "fov": 85,
        // look down a little bit (I used 0.45 for better view)
        "tilt": 0.25
      },
      "controls": {
        "pitch_ratio": 1.7,
        "roll_ratio": 1.1,
        "yaw_ratio": 1.3
      },
      "aircraft": {
        "weight": 120000,
        // 130000 at max speed
        "engine_thrust": 108333,
        "max_speed": 600,
        "stall_speed": 65,
        "vle_speed": 150,
        "lift_coefficient": 1.92,
        "drag_coefficient": 0.46,
        "bank_induce_yaw_ratio": 0.2,
        "lift_loss_pitch_ratio": 0.1,
        "air_damping_factor": 2.5,
        "min_authority": 0.1,
        "friction_coefficient": 2,
        "pitch_ratio": 7.7,
        "roll_ratio": 9.1,
        "yaw_ratio": 10.3
      },
      "position": {
        "threshold": 5000,
        "height_path": "world-hm",
        "max_relative_height": 3500,
        // 104.65,
        "height_map_size_ratio": 105,
        "height_above_ground": 5
      },
      // todo not needed anymore, but still used for stall warning
      "groundCheck": {
        "stall_speed": 65
      }
    },
    "scene": {
      "map_texture": "assets/images/north-tx-2048.jpg",
      "map_heightmap": "assets/tiles/north/heightmap.png",
      "map_size": {
        "x": 128000,
        "y": 5000,
        "z": 128000
      },
      "fog_shader_vs": "assets/shaders/fog.vs",
      "fog_shader_fs": "assets/shaders/fog.fs"
    },
    "views": {
      "hud": {
        "ladder": {
          "x": 440,
          "y": 200,
          "width": 320,
          "height": 220,
          "offset": 0.0
        },
        "roc": {
          "x": 740,
          "y": 318,
          "width": 4,
          "height": 220
        },
        "speedometer": {
          "x": 430,
          "y": 310,
          "font": 14
        },
        "height": {
          "x": 750,
          "y": 310,
          "font": 14
        },
        "boresight": {
          "x": 600,
          "y": 400,
          "size": 24
        },
        "heading": {
          "x": 600,
          "y": 210,
          "width": 300,
          "font": 12
        },
        "warnings": {
          "x": 450,
          "y": 390,
          "font": 12
        }
      },
      "minimap": {
        "map_texture": "minimap-tex",
        "size": 150,
        "maps_ratio": 128,
        "default_map_zoom": 14
      },
      "cockpit": {
        "texture_path": "cockpit-tex",
        "shader_path": "cockpit-chroma",
        "tint_color": [
          255,
          255,
          255,
          255
        ]
      },
      "radar": {
        "size": 150,
        "ranges": [
          5000,
          20000,
          50000
        ]
      }
    },
    "screens": {
      "splash": {
        "bg_tex_path": "assets/images/splash.png",
        "bg_sound_path": "assets/sound/splash-1.mp3"
      }
    }
  }
}