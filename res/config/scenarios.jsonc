    // ── Mission 3: Photo Recon ─────────────────────────────────
    {
      "id": "photo-recon",
      "name": "Photo Recon",
      "description": "Photograph three enemy installations for intelligence. Camera pod required — you carry no bombs on this sortie. Stay low and fast.",
      "difficulty": "medium",
      "theater": "north",

      "start": {
        "position": [10000, 100, 10000],    // placeholder
        "heading": 45,
        "speed": 0,
        "altitude": 100,
        "fuel": 4000,
        "carrier": true
      },

      "loadout": {
        "slots": 6,
        "available": ["aim9", "aim7", "camera_pod"],
        "default": ["aim9", "aim9", "aim7", "aim7", "camera_pod", "camera_pod"]
      },

      "objectives": [
        {
          "id": "obj-photo-airfield",
          "type": "photograph",
          "target": "enemy-airfield",
          "label": "Photograph the enemy airfield",
          "required": true,
          "order": 1,
          "params": {
            "minAltitude": 300,
            "maxAltitude": 2000,
            "maxDistance": 500,
            "requiredAngle": 30
