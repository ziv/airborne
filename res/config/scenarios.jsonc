        },
        {
          "id": "obj-photo-depot",
          "type": "photograph",
          "target": "supply-depot",
          "label": "Photograph the supply depot",
          "required": true,
          "order": 2,
          "params": {
            "minAltitude": 300,
            "maxAltitude": 2000,
            "maxDistance": 500,
            "requiredAngle": 30
          }
        },
        {
          "id": "obj-photo-radar",
          "type": "photograph",
          "target": "radar-complex",
          "label": "Photograph the radar complex",
          "required": true,
          "order": 3,
          "params": {
            "minAltitude": 300,
            "maxAltitude": 2000,
            "maxDistance": 500,
            "requiredAngle": 30
