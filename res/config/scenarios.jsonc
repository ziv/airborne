{
  // ─────────────────────────────────────────────────────────────
  // Airborne — Mission Definitions
  // All scenarios are defined here and loaded by the main menu.
  // Entity positions are world coordinates [x, y, z] in meters.
  // ─────────────────────────────────────────────────────────────
  "scenarios": [

    // ── Mission 1: First Strike (Tutorial) ─────────────────────
    {
      "id": "first-strike",
      "name": "First Strike",
      "description": "Destroy the enemy radar installation to open a corridor for follow-up strikes. Low threat environment — ideal for your first combat sortie.",
      "difficulty": "easy",
      "theater": "north",

      "start": {
        "position": [30000, 150, 60000],   // placeholder — carrier deck
        "heading": 90,
        "speed": 0,
        "altitude": 100,
        "fuel": 3500,
        "carrier": true
      },

      "loadout": {
        "slots": 6,
        "available": ["aim9", "mk82", "mk84"],
        "default": ["aim9", "aim9", "mk82", "mk82", "mk84", "mk84"]
      },

      "objectives": [
        {
          "id": "obj-radar",
          "type": "destroy",
          "target": "radar-station",
          "label": "Destroy the radar installation",
          "required": true,
          "order": 1
        },
        {
          "id": "obj-rtb",
          "type": "navigate",
          "target": "home-base",
          "label": "Return to base",
          "required": true,
          "order": 99,
          "params": { "arrivalRadius": 2000 }
        }
      ],

      "entities": [
        {
          "id": "home-base",
          "type": "airbase",
          "subtype": "carrier",
          "position": [30000, 0, 60000],    // placeholder
          "heading": 90,
          "faction": "friendly",
//          "model": "res/carrier_scene.glb"
          "model": "res/gerald_ford_aircraft_carrier.glb",
          "scale": 0.5
        },
        {
          "id": "abother-home-base",
          "type": "airbase",
          "subtype": "international-airport",
          "position": [41000, 0, 74000],    // placeholder
          "heading": 90,
          "faction": "friendly",
          "model": "res/airport.glb"
        },
        {
          "id": "radar-station",
          "type": "structure",
          "subtype": "radar",
          "position": [32500, 0, 58000],    // placeholder — target area
          "heading": 0,
          "health": 100,
          "faction": "enemy",
          "model": "res/aa-radar.glb"
        },
        // light AAA defending the radar
        {
          "id": "aaa-01",
          "type": "aaa",
          "subtype": "zsu23",
          "position": [40000, 100, 60000],    // placeholder — near radar
          "heading": 0,
          "health": 50,
          "faction": "enemy",
          "model": "res/mig23.glb",
          "params": {
            "detectionRange": 5000,
            "engagementRange": 3000,
            "maxAltitude": 3000,
            "fireRate": 10.0,
            "accuracy": 0.2,
            "burstDuration": 2.0
          }
        },
        {
          "id": "aaa-02",
          "type": "aaa",
          "subtype": "zsu23",
          "position": [30500, 0, 59500],    // placeholder — near radar
          "heading": 0,
          "health": 50,
          "faction": "enemy",
          "model": "res/mig23.glb",
          "params": {
            "detectionRange": 5000,
            "engagementRange": 3000,
            "maxAltitude": 3000,
            "fireRate": 10.0,
            "accuracy": 0.2,
            "burstDuration": 2.0
          }
        }
      ],

      "triggers": [],

      "completion": {
        "success": "all_required_objectives",
        "failure": ["player_destroyed", "player_ejected"]
      },

      "scoring": {
        "objectiveComplete": 1000,
        "bonusObjective": 500,
        "enemyAircraftKill": 250,
        "samDestroyed": 200,
        "aaaDestroyed": 100,
        "timeBonus": true,
        "fuelBonus": true,
        "noDamageBonus": 500
      }
    },

